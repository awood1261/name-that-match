{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "build",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["server/src/**/*.ts", "shared/src/**/*.ts"],
  "exclude": ["build", "node_modules", "client", "tests"]
}
